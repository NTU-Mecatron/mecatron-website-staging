---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import site from '../../../data/team';
import '../../styles/global.css';

const logs = (await getCollection('logs')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const page = await getEntry('sitePages', 'logs');
if (!page) throw new Error('Missing logs page content at src/content/sitePages/logs.md');
---

<BaseLayout title={page.data.title} description={page.data.description} siteName={site.name}>
  <Header />
  <main class="container">
    <header class="page-intro">
      <h1>Field<br /><em>logs.</em></h1>
      <p>{page.data.description}</p>
    </header>
    <div class="log-page-grid">
      {logs.map((log) => (
        <article class="log-item">
          <span class="tag">{log.data.category} · {log.data.readTime}</span>
          <h3><a href={`/logs/${log.slug}`}>{log.data.title}</a></h3>
          <p>{log.data.description}</p>
        </article>
      ))}
    </div>
  </main>
  <footer><small>{site.copyright}</small><small><a href="/">{page.data.backLabel} ↗</a></small></footer>
</BaseLayout>
